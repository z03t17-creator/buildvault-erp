APP_NAME="BuildVault ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Production (SiteBunker) — use these on the live host:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default: SQLite. On SiteBunker Enterprise use MariaDB (mysql):
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=your_cpanel_db
# DB_USERNAME=your_cpanel_user
# DB_PASSWORD=your_db_password
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# SiteBunker Enterprise: database drivers (no Redis / no Memcached required)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD

# Attendance shift defaults (Phase 2.3)
ATTENDANCE_SHIFT_START=08:00
ATTENDANCE_SHIFT_END=17:00
ATTENDANCE_LATE_GRACE_MINUTES=0
ATTENDANCE_ABSENT_CUTOFF=10:00

# Payroll penalties (Phase 2.4) — see config/payroll.php
PAYROLL_LATE_PENALTY_PER_MINUTE=0.25
# PAYROLL_ABSENCE_PENALTY_USD=          # optional fixed USD; else daily_rate × multiplier
PAYROLL_ABSENCE_PENALTY_MULTIPLIER=1.0
PAYROLL_COUNT_LEAVE_PAID=true
PAYROLL_COUNT_LEAVE_SICK=false

VITE_APP_NAME="${APP_NAME}"

# Activity log (spatie/laravel-activitylog)
ACTIVITY_LOGGER_ENABLED=true

# Compliance / retention targets — confirm with counsel (often 7+ years in Iraq). Not legal advice.
COMPLIANCE_RETENTION_YEARS=7
COMPLIANCE_BACKUP_DAILY_HOT_DAYS=30
COMPLIANCE_BACKUP_WEEKLY_ARCHIVE_WEEKS=52
COMPLIANCE_BACKUP_COLD_YEARS=7


